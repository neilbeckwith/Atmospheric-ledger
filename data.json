 "ecvs": [
  {
   "name": "Surface temperature",
   "group": "Surface",
   "role": "Air temperature near the surface \u2014 the warming itself, measured by the station network behind GISTEMP and the other surface records."
  },
  {
   "name": "Precipitation",
   "group": "Surface",
   "role": "Rain and snow: the water cycle's delivery. Warming air holds about 7% more water vapour per degree, so rain falls harder and droughts bite deeper."
  },
  {
   "name": "Surface pressure",
   "group": "Surface",
   "role": "The weight of the air above a point; its patterns steer the winds and the storms that move heat and moisture around the planet."
  },
  {
   "name": "Surface wind speed and direction",
   "group": "Surface",
   "role": "Winds move heat, moisture and CO2 itself \u2014 and set how fast the ocean and land sinks can take carbon out of the air."
  },
  {
   "name": "Surface water vapour",
   "group": "Surface",
   "role": "Water vapour is the strongest greenhouse gas by amount, and a feedback: warmer air holds more of it, which traps more heat."
  },
  {
   "name": "Surface radiation budget",
   "group": "Surface",
   "role": "Sunlight in, infrared out at the ground \u2014 the balance that decides whether the surface warms or cools."
  },
  {
   "name": "Upper-air temperature",
   "group": "Upper-air",
   "role": "Temperature through the troposphere and stratosphere. The troposphere warms while the stratosphere cools \u2014 the fingerprint of greenhouse warming, not solar warming."
  },
  {
   "name": "Upper-air wind speed and direction",
   "group": "Upper-air",
   "role": "The jet streams and the circulation aloft; their shifts move storms, heatwaves and the monsoons."
  },
  {
   "name": "Upper-air water vapour",
   "group": "Upper-air",
   "role": "Water vapour above the surface, including the stratosphere, where it acts as a greenhouse gas and shapes ozone chemistry."
  },
  {
   "name": "Earth radiation budget",
   "group": "Upper-air",
   "role": "Sunlight in minus infrared out at the top of the atmosphere, measured by CERES satellites \u2014 the direct measure of the energy imbalance driving warming, about +1 W/m2 in recent years."
  },
  {
   "name": "Lightning",
   "group": "Upper-air",
   "role": "Lightning frequency tracks storm intensity and convection, and its nitrogen oxides feed ozone and aerosol chemistry."
  },
  {
   "name": "Clouds",
   "group": "Atmospheric composition",
   "role": "Cloud properties \u2014 amount, height, type. Clouds cool by reflecting sunlight and warm by trapping infrared; their net effect is the largest uncertainty in how much warming a given forcing brings."
  },
  {
   "name": "Aerosols",
   "group": "Atmospheric composition",
   "role": "Airborne particles \u2014 sulfate, dust, soot, sea salt. They reflect sunlight and seed clouds, cooling the planet by about 1.1 W/m2 and masking part of the greenhouse warming."
  },
  {
   "name": "Carbon dioxide, methane and other greenhouse gases",
   "group": "Atmospheric composition",
   "role": "The well-mixed greenhouse gases \u2014 CO2, CH4, N2O and halocarbons. Their rising concentrations are the forcing this ledger measures: CO2 425.6 ppm and CH4 1,936 ppb in 2025."
  },
  {
   "name": "Ozone",
   "group": "Atmospheric composition",
   "role": "Ozone in the stratosphere shields life from UV; ozone in the troposphere is a greenhouse gas and a pollutant. Its forcing since 1750 is about +0.47 W/m2."
  },
  {
   "name": "Precursors for aerosols and ozone",
   "group": "Atmospheric composition",
   "role": "The gases that make aerosols and ozone \u2014 SO2, NOx, ammonia, volatile organic compounds \u2014 mostly from burning fuel and from farming."
  }
 ],
 "processes": [
  {
   "abbr": "EMIT",
   "name": "Emissions \u2014 the input",
   "role": "Humans emitted 11.79 GtC in 2024 (10.54 GtC fossil fuels and cement, 1.25 GtC land-use change; Global Carbon Budget 2025). Every tonne starts here; the rest of the ledger is where it goes.",
   "source": "Friedlingstein et al. 2025 (GCB 2025)"
  },
  {
   "abbr": "AIR",
   "name": "Airborne fraction \u2014 what stays in the air",
   "role": "About 42% of cumulative emissions since 1959 stayed in the atmosphere (the airborne fraction); the rest went into the land and ocean sinks. In 2024 the fraction hit 67% \u2014 the record CO2 growth year, when the tropical land sink collapsed in the El Ni\u00f1o drought. The fraction, not the emissions alone, sets how fast CO2 rises.",
   "source": "Friedlingstein et al. 2025 (GCB 2025); computed in data.json"
  },
  {
   "abbr": "GREEN",
   "name": "The greenhouse effect \u2014 why CO2 warms",
   "role": "CO2 absorbs infrared at 15 micrometres, the wavelength Earth radiates to space. Adding CO2 closes that window a little more, so the surface must warm to radiate the same energy. The forcing grows logarithmically \u2014 about 5.35 x ln(C/C0) W/m2 \u2014 so each extra ppm matters less than the last, but the total since 1750 is +2.16 W/m2, and a doubling of CO2 gives +3.93 W/m2.",
   "source": "IPCC AR6 WG1, Chapter 7 (Forster et al. 2021)"
  },
  {
   "abbr": "SINKS",
   "name": "Land and ocean sinks \u2014 what leaves the air",
   "role": "In 2024 the land took up 1.94 GtC and the ocean 3.39 GtC (GCB 2025). The sinks grow with CO2 \u2014 more CO2 fertilises photosynthesis and pushes more gas into seawater \u2014 but they weaken as the planet warms: heat and drought cut the land sink, and warmer water holds less CO2. The sinks are why only about half of emissions stay airborne.",
   "source": "Friedlingstein et al. 2025 (GCB 2025)"
  },
  {
   "abbr": "CH4",
   "name": "Methane \u2014 the fast gas",
   "role": "Methane reached 1,935.95 ppb in 2025, up from 722 ppb pre-industrial, growing 6.5 ppb in 2025 alone. Its forcing since 1750 is +0.54 W/m2, and it lives only about 12 years in the air \u2014 so cutting methane cools the planet within a decade, unlike CO2, which lingers for centuries.",
   "source": "NOAA GML global CH4 (this build); IPCC AR6 WG1, Chapter 7"
  },
  {
   "abbr": "AERO",
   "name": "Aerosols \u2014 the cooling mask",
   "role": "Air pollution cools the planet by about 1.1 W/m2 (aerosol-radiation -0.84, aerosol-cloud -0.22; IPCC AR6) \u2014 masking roughly a third of the greenhouse warming. Cleaning up the air saves lives but unmasks warming, which is why the net forcing (+2.72 W/m2) is smaller than the greenhouse gases alone (+3.32 W/m2).",
   "source": "IPCC AR6 WG1, Chapter 7 (Forster et al. 2021)"
  },
  {
   "abbr": "BALANCE",
   "name": "The budget identity \u2014 it has to add up",
   "role": "Emissions = atmospheric growth + land sink + ocean sink + cement carbonation + budget imbalance. In 2024: 11.79 = 7.92 + 1.94 + 3.39 + 0.22 - 1.69 GtC \u2014 the imbalance is the part the measured terms do not account for. And the energy balance must add up too: the +2.72 W/m2 of forcing is balanced by warming plus heat stored in the ocean. The ledger is two account books \u2014 carbon and energy \u2014 and they have to close together.",
   "source": "Friedlingstein et al. 2025 (GCB 2025); IPCC AR6 WG1, Chapter 7"
  }
 ],
